<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-feature android:name="android.hardware.vulkan.version" android:version="0x400003" android:required="true" />
    <application android:label="RallyNVX" android:allowBackup="false" android:theme="@android:style/Theme.Material.NoActionBar">
        <activity android:name=".StartActivity" android:exported="true"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|keyboardHidden|screenSize|screenLayout|smallestScreenSize|uiMode|density|keyboard|navigation|fontScale|layoutDirection|locale">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".SettingsActivity" android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|keyboardHidden|screenSize|screenLayout|smallestScreenSize|uiMode|density|keyboard|navigation|fontScale|layoutDirection|locale" />
        <activity android:name=".RallyMenuActivity" android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|keyboardHidden|screenSize|screenLayout|smallestScreenSize|uiMode|density|keyboard|navigation|fontScale|layoutDirection|locale" />
        <activity android:name=".VoiceMenuActivity" android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|keyboardHidden|screenSize|screenLayout|smallestScreenSize|uiMode|density|keyboard|navigation|fontScale|layoutDirection|locale" />
        <activity android:name=".RecordVoiceActivity" android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|keyboardHidden|screenSize|screenLayout|smallestScreenSize|uiMode|density|keyboard|navigation|fontScale|layoutDirection|locale" />
        <activity android:name=".GarageActivity" android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|keyboardHidden|screenSize|screenLayout|smallestScreenSize|uiMode|density|keyboard|navigation|fontScale|layoutDirection|locale" />
        <activity android:name=".GameActivity" android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|keyboardHidden|screenSize|screenLayout|smallestScreenSize|uiMode|density|keyboard|navigation|fontScale|layoutDirection|locale" />
        <activity android:name=".MainActivity" android:exported="true"
            android:screenOrientation="fullUser"
            android:configChanges="orientation|keyboardHidden|screenSize|screenLayout|smallestScreenSize|uiMode|density|keyboard|navigation|fontScale|layoutDirection|locale" />
    </application>
</manifest>
